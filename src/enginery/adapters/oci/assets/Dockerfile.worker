# Isolated runner worker image.
#
# Every input is pinned: the base by multi-arch index digest, the Debian packages by an archive
# snapshot plus exact versions, uv by image digest, and the coding harnesses with all of their
# transitive npm dependencies by a lockfile of integrity hashes. Nothing secret is ever baked in;
# credentials reach a worker only through a runtime allowlist.
#
# The harness versions below are also the labels the image carries and must equal both the
# package manifest and the execution catalog (checked by the recipe tests). The image is built
# from a context containing exactly the recipe files (this file, worker_entry.py, checkout_entry.py,
# runtime-requirements.txt, the omp permission overlay, and the npm manifest and lockfile).
# enginery-checkout runs ./src/enginery with the pinned Python 3.12 runtime and locked dependencies;
# Debian python3 remains available independently. It runs with a read-only root filesystem,
# no capabilities, uid/gid 65532, and tmpfs /tmp + /home/worker.
ARG NODE_BASE_IMAGE=node:22-bookworm-slim
ARG NODE_BASE_DIGEST=sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.13.0
ARG UV_DIGEST=sha256:cdc6093146eb3ff6a40107b38f008b789e050e77ad87865e381d9917da55a168

FROM ${UV_IMAGE}@${UV_DIGEST} AS uv

FROM ${NODE_BASE_IMAGE}@${NODE_BASE_DIGEST}

ARG DEBIAN_SNAPSHOT=20261005T000000Z
ARG GIT_VERSION=1:2.39.5-0+deb12u3
ARG PYTHON3_VERSION=3.11.2-1+b1
ARG CA_CERTIFICATES_VERSION=20250419~deb12u1
ARG CPYTHON_VERSION=3.12.15
ARG BUN_VERSION=1.3.14
ARG CLAUDE_CODE_VERSION=2.1.296
ARG OMP_VERSION=18.10.3
ARG WORKER_UID=65532
ARG WORKER_GID=65532

USER root

# Debian packages come from the archive snapshot the pinned base was built from, so the exact
# versions below stay installable and a rebuild resolves the same bytes.
RUN set -eu; \
    printf '%s\n' \
      'Types: deb' \
      "URIs: http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}" \
      'Suites: bookworm bookworm-updates' \
      'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
      'Check-Valid-Until: no' \
      '' \
      'Types: deb' \
      "URIs: http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}" \
      'Suites: bookworm-security' \
      'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
      'Check-Valid-Until: no' \
      > /etc/apt/sources.list.d/debian.sources; \
    apt-get -o Acquire::Retries=5 update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      "ca-certificates=${CA_CERTIFICATES_VERSION}" \
      "git=${GIT_VERSION}" \
      "python3=${PYTHON3_VERSION}"; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/*; \
    groupadd --gid "${WORKER_GID}" worker; \
    useradd --uid "${WORKER_UID}" --gid "${WORKER_GID}" --home-dir /home/worker \
      --create-home --shell /bin/bash worker; \
    install -d -o "${WORKER_UID}" -g "${WORKER_GID}" -m 0755 /workspace /out; \
    install -d -m 0755 /opt/enginery; \
    git config --system --add safe.directory /workspace

COPY --from=uv /uv /uvx /usr/local/bin/

# uv's digest pins its interpreter download catalog (including archive hashes). Keep the
# interpreter and runtime-only venv root-owned; do not replace Debian's python3 or put the
# venv's unversioned python3 first on PATH. Both supported architectures use uv.lock wheel hashes.
COPY runtime-requirements.txt /opt/enginery/
RUN set -eu; \
    UV_PYTHON_INSTALL_DIR=/opt/enginery-python \
      uv python install --no-bin "${CPYTHON_VERSION}"; \
    UV_PYTHON_INSTALL_DIR=/opt/enginery-python \
      uv venv --python "${CPYTHON_VERSION}" /opt/enginery/runtime; \
    uv pip install --python /opt/enginery/runtime/bin/python3.12 \
      --require-hashes --only-binary :all: -r /opt/enginery/runtime-requirements.txt; \
    chown -R root:root /opt/enginery-python /opt/enginery/runtime; \
    chmod -R go-w /opt/enginery-python /opt/enginery/runtime; \
    chmod 0444 /opt/enginery/runtime-requirements.txt; \
    rm -rf /root/.cache /tmp/*

COPY checkout_entry.py /usr/local/bin/enginery-checkout
RUN chown root:root /usr/local/bin/enginery-checkout; \
    chmod 0555 /usr/local/bin/enginery-checkout

# Harness packages, installed as root and read-only to the worker at runtime. They are installed
# from the lockfile shipped next to this file (`npm ci`), so every transitive package, including
# the platform binaries, is the exact tarball whose integrity hash is recorded there; the lock and
# its manifest are part of the recipe digest. bun is required by the omp launcher
# (`#!/usr/bin/env bun`); claude-code and bun resolve their platform binary through optional
# dependencies, which exist for linux arm64 and x64. The packages' install scripts only link those
# already-fetched binaries, except onnxruntime-node's optional CUDA download on linux x64: that
# one is not part of the lock, so it is switched off and the CPU binaries inside the tarball are
# used.
COPY package.json package-lock.json /opt/enginery/harness/
RUN set -eu; \
    cd /opt/enginery/harness; \
    ONNXRUNTIME_NODE_INSTALL_CUDA=skip \
      npm ci --omit=dev --no-audit --no-fund --loglevel=error; \
    for bin in bun omp claude; do \
      ln -s "/opt/enginery/harness/node_modules/.bin/${bin}" "/usr/local/bin/${bin}"; \
    done; \
    npm cache clean --force; \
    rm -rf /root/.npm /root/.cache /tmp/*

# Root-owned and read-only to the worker: the entrypoint and the harness permission overlay.
COPY worker_entry.py omp-isolated-policy.yml /opt/enginery/
RUN chown root:root /opt/enginery/worker_entry.py /opt/enginery/omp-isolated-policy.yml; \
    chmod 0444 /opt/enginery/worker_entry.py /opt/enginery/omp-isolated-policy.yml

# Harnesses must not update themselves or phone home from a worker.
# Append the actual venv bin directory: a symlink outside it loses Python's venv detection.
ENV HOME=/home/worker \
    PATH="${PATH}:/opt/enginery/runtime/bin" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DISABLE_AUTOUPDATER=1 \
    DISABLE_TELEMETRY=1 \
    DISABLE_ERROR_REPORTING=1 \
    DISABLE_BUG_COMMAND=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    DO_NOT_TRACK=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    GIT_TERMINAL_PROMPT=0

LABEL dev.enginery.runner-image="1" \
      dev.enginery.claude-code="${CLAUDE_CODE_VERSION}" \
      dev.enginery.omp="${OMP_VERSION}" \
      dev.enginery.bun="${BUN_VERSION}"

USER ${WORKER_UID}:${WORKER_GID}
WORKDIR /workspace

# The launcher passes the full command; the base image's entrypoint script must not interpose.
ENTRYPOINT []
CMD []
